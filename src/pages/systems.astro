---
import Page from '../layouts/Page.astro'
import pages from '../data/pages.json'
const p = pages.systems
---
<Page title={p.title} count={p.count} intro={p.intro}>
  <div class="rows in" style="--i:4">
    {p.items.map((it) => <div class={`row ${it.s}`}><div class="t3">{it.k}</div><p class="body">{it.v}</p><span class="mono s">{it.s}</span></div>)}
  </div>
  <p class="body promise in" style="--i:5">{p.ask}</p>
  <a class="mono golink in" style="--i:6" href={p.cta.href} data-cur="write">{p.cta.label} →</a>
</Page>
