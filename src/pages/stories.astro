---
import Page from '../layouts/Page.astro'
import pages from '../data/pages.json'
const p = pages.stories
const mark = (t) => t.split(/([\u2e80-\u9fff\uff00-\uffef\u3000-\u30ff]+)/).filter(Boolean).map((seg) => ({ seg, cjk: /[\u2e80-\u9fff\uff00-\uffef\u3000-\u30ff]/.test(seg) }))
---
<Page title={p.title} count={p.count} intro={p.intro}>
  <p class="body note in" style="--i:4">{p.note}</p>
  <div class="cards in" style="--i:5">
    {p.items.map((it, i) => {
      const Tag = it.href ? 'a' : 'div'
      return (
        <Tag class={`card${it.href ? '' : ' soon'}`} href={it.href || undefined} target={it.href ? '_blank' : undefined} rel={it.href ? 'noopener' : undefined} data-cur={it.href ? 'watch' : undefined}>
          <img src={`/assets/strip/${it.src}`} alt="" loading="lazy" />
          <div class="card-meta">
            <div class="mono who">{String(i + 1).padStart(2, '0')} · {it.name} · {it.role} · {it.place}</div>
            <p class="t3 q">{it.kind !== 'photo' && '"'}{mark(it.line).map((x) => x.cjk ? <span class="cjk">{x.seg}</span> : x.seg)}{it.kind !== 'photo' && '"'}</p>
            {it.sub && <p class="body subq">{it.sub}</p>}
            <div class="mono go">{it.kind === 'wrote' ? 'from the notebook' : it.kind === 'photo' ? 'from the camera roll' : (it.href ? 'watch the cut →' : 'cut coming')}</div>
          </div>
        </Tag>
      )
    })}
  </div>
  <a class="mono golink in" style="--i:6" href={p.cta.href} target="_blank" rel="noopener" data-cur="apply">{p.cta.label} →</a>
</Page>
