---
import '../styles/global.css'
import site from '../data/site.json'
import pages from '../data/pages.json'
const cjk = [...new Set(pages.stories.items.flatMap((it) => [...it.line]).filter((ch) => ch.charCodeAt(0) > 0x2e80))].join('')
const {
  title = 'fomties™ — figuring out my twenties',
  description = site.sub,
} = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a5fd8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400&family=Noto+Serif+SC:wght@400&display=swap&text=${encodeURIComponent(cjk)}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.fomties.com/assets/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try { if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rm') } catch (e) {}
      try { if (matchMedia('(hover:hover) and (pointer:fine)').matches) document.documentElement.classList.add('fine') } catch (e) {}
      try { const force = new URLSearchParams(location.search).has('intro'); if (!force && (location.pathname !== '/' || sessionStorage.getItem('intro') || matchMedia('(prefers-reduced-motion: reduce)').matches)) document.documentElement.classList.add('nointro', 'ready') } catch (e) {}
    </script>
  </head>
  <body>
    <div class="intro" id="intro" aria-hidden="true">
      <div class="ivl"></div>
      <div class="iwrap">
        <span class="iname" id="iname" data-from={site.intro.from} data-to={site.intro.to}>{site.intro.from}</span>
        <span class="itc mono"><i class="rec"></i><span id="itc" data-born={site.born}>left of my twenties</span></span>
      </div>
    </div>
    <div class="scene" id="scene">
      <div class="photo" id="photo" aria-hidden="true"></div>
      <div class="veil" aria-hidden="true"></div>
      <div class="glow" id="glow" aria-hidden="true"></div>
      <svg class="grain" aria-hidden="true"><filter id="g"><feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="3" stitchTiles="stitch" /><feColorMatrix type="saturate" values="0" /></filter><rect width="100%" height="100%" filter="url(#g)" /></svg>
    </div>
    <div class="wrap">
      <slot />
    </div>
    <div class="room" id="room" aria-hidden="true" data-list={JSON.stringify(site.room)}></div>
    <div class="cur" id="cur" aria-hidden="true"><i></i><b id="curlbl"></b></div>
    <div class="toast" id="toast">copied {site.email}</div>
    <script src="../scripts/site.js"></script>
  </body>
</html>
